{
  "name": "@pfoundation/oc2iterm",
  "version": "0.1.0",
  "description": "OpenCode CLI plugin: mirror agent status to iTerm2 3.7+ Session Status (tab subtitle + dot).",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfoundation/oc2Iterm.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cli-plugin",
    "iterm2",
    "terminal",
    "session-status"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "tui.ts",
    "src/**/*.ts"
  ],
  "exports": {
    "./tui": "./src/tui.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "probe": "bun scripts/probe.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
